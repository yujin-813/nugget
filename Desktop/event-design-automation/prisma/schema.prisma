generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id           String        @id @default(cuid())
  name         String
  targetUrl    String
  analysisGoal String
  toolType     String        @default("ga4") // ga4, amplitude
  sitemapOverrideJson String?
  gtmAccountId String?
  gtmContainerId String?
  gtmWorkspaceId String?
  ga4MeasurementId String?
  amplitudeApiKey String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  pages        Page[]
  events       Event[]
  analyzeJobs  AnalyzeJob[]
}

model Page {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  title     String?
  pageType  String?
  createdAt DateTime    @default(now())
  components Component[]
  events    Event[]
}

model Component {
  id            String   @id @default(cuid())
  pageId        String
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  componentType String
  label         String?
  selector      String?
  metadataJson  String?  // Store JSON as string if needed
}

model Event {
  id               String          @id @default(cuid())
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pageId           String?
  page             Page?           @relation(fields: [pageId], references: [id], onDelete: SetNull)
  eventName        String
  description      String?
  triggerType      String?
  triggerCondition String?
  priority         String?         @default("MEDIUM")
  status           String          @default("draft") // draft, approved, ready_for_dev
  sourceType       String          @default("ai")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  properties       EventProperty[]
}

model EventProperty {
  id           String  @id @default(cuid())
  eventId      String
  event        Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  propertyName String
  propertyType String
  exampleValue String?
  isRequired   Boolean @default(false)
}

model AnalyzeJob {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       String   @default("queued") // queued, running, completed, failed
  progress     Int      @default(0)
  resultJson   String?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  startedAt    DateTime?
  completedAt  DateTime?
}
