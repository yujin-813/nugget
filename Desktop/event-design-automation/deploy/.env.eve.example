# Runtime
NODE_ENV=production
PORT=3100
PUBLIC_BASE_URL=https://eve.asknuggetdata.com

# Prisma (EVE 전용 DB)
DATABASE_URL="file:/srv/eve-event-app/data/eve.db"

# Login OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backward compatibility for legacy env names
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GTM OAuth
GOOGLE_OAUTH_REDIRECT_URI=https://eve.asknuggetdata.com/api/gtm/oauth/callback

# Optional OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional GTM fallback (권장: UI 모달 입력/프로젝트 저장)
GTM_ACCESS_TOKEN=
GTM_ACCOUNT_ID=
GTM_CONTAINER_ID=
GTM_WORKSPACE_ID=
GTM_GA4_MEASUREMENT_ID=
AMPLITUDE_API_KEY=

# Optional client-side GTM script
NEXT_PUBLIC_GTM_ID=
